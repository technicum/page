{% extends "layouts/base.njk" %}
{% block head %}
<style>
*{box-sizing:border-box;}
body{font-family:"Inter",system-ui,sans-serif;background:#f7f7f8;margin:0;}
.dash-main{flex:1;display:flex;flex-direction:column;min-width:0;}
.topbar{height:56px;background:#fff;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;padding:0 24px;gap:12px;position:sticky;top:0;z-index:100;flex-shrink:0;}
.topbar-title{font-size:15px;font-weight:700;color:#111827;flex:1;}
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:all .15s;border:none;cursor:pointer;font-family:inherit;}
.btn-dark{background:#111827;color:#fff;}.btn-dark:hover{background:#374151;}
.btn-outline{background:#fff;color:#374151;border:1.5px solid #e5e7eb;}.btn-outline:hover{border-color:#6366f1;color:#6366f1;}
.btn-red{background:#fee2e2;color:#ef4444;border:none;}.btn-red:hover{background:#fecaca;}
.page{max-width:900px;margin:0 auto;padding:32px 24px 60px;width:100%;}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;}
.page-title{font-size:22px;font-weight:700;color:#111827;}
.page-sub{font-size:13px;color:#9ca3af;margin-top:2px;}

/* ── Website cards ─── */
.site-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;}
.site-card{background:#fff;border:1.5px solid #e5e7eb;border-radius:16px;overflow:hidden;transition:box-shadow .15s,border-color .15s;}
.site-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.08);border-color:#c7d2fe;}
.site-thumb{height:140px;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 100%);display:flex;align-items:center;justify-content:center;font-size:40px;position:relative;}
.site-pub-badge{position:absolute;top:10px;right:10px;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:.3px;}
.site-pub-badge.live{background:#dcfce7;color:#16a34a;}
.site-pub-badge.draft{background:#f3f4f6;color:#6b7280;}
.site-info{padding:16px;}
.site-name{font-size:15px;font-weight:700;color:#111827;margin:0 0 4px;}
.site-url{font-size:12px;color:#9ca3af;margin:0 0 12px;}
.site-actions{display:flex;gap:8px;}

/* ── Empty state ─── */
.empty{text-align:center;padding:80px 20px;}
.empty-icon{font-size:52px;margin-bottom:16px;}
.empty-title{font-size:20px;font-weight:700;color:#111827;margin-bottom:8px;}
.empty-sub{font-size:14px;color:#9ca3af;margin-bottom:24px;}

/* ── Name modal ─── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;align-items:center;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal{background:#fff;border-radius:16px;padding:28px;width:420px;max-width:92vw;}
.modal-title{font-size:18px;font-weight:700;color:#111827;margin:0 0 6px;}
.modal-sub{font-size:13px;color:#9ca3af;margin:0 0 20px;}
.form-group{margin-bottom:16px;}
.form-label{display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;}
.form-input{width:100%;padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;font-family:inherit;outline:none;transition:border-color .15s;}
.form-input:focus{border-color:#6366f1;}
.modal-footer{display:flex;gap:8px;justify-content:flex-end;margin-top:20px;}

/* ═══════════════════════════════════════════════
   FULL-SCREEN THEME CHOOSER (create flow)
═══════════════════════════════════════════════ */
#wlThemeChooser{position:fixed;inset:0;background:#fff;z-index:600;display:none;flex-direction:column;font-family:"Inter",system-ui,sans-serif;}
.wltc-head{background:#fff;border-bottom:1px solid #f0f0f0;padding:20px 32px 16px;text-align:center;flex-shrink:0;}
.wltc-title{font-size:20px;font-weight:800;color:#111827;margin-bottom:4px;}
.wltc-title span{color:#6366f1;font-style:italic;}
.wltc-sub{font-size:13px;color:#6b7280;margin-bottom:14px;}
.wltc-search-row{display:flex;gap:10px;max-width:560px;margin:0 auto;}
.wltc-search{flex:1;padding:8px 14px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;font-family:inherit;outline:none;}
.wltc-search:focus{border-color:#6366f1;}
.wltc-cat-select{padding:8px 14px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;font-family:inherit;background:#fff;cursor:pointer;outline:none;}
.wltc-chips{display:flex;gap:7px;padding:10px 32px;border-bottom:1px solid #f0f0f0;background:#fafafa;flex-wrap:wrap;flex-shrink:0;}
.wltc-chip{padding:5px 14px;border:1.5px solid #e5e7eb;border-radius:20px;font-size:12px;font-weight:500;cursor:pointer;background:#fff;font-family:inherit;transition:all .15s;color:#374151;}
.wltc-chip:hover{border-color:#a5b4fc;color:#6366f1;}
.wltc-chip.active{background:#111827;color:#fff;border-color:#111827;}
.wltc-body{display:flex;flex:1;overflow:hidden;}
.wltc-sidebar{width:170px;flex-shrink:0;border-right:1px solid #f0f0f0;padding:16px 14px;overflow-y:auto;background:#fafafa;}
.wltc-cat-label{font-size:10px;font-weight:700;color:#9ca3af;letter-spacing:.8px;text-transform:uppercase;margin-bottom:10px;}
.wltc-cat-item{display:flex;align-items:center;justify-content:space-between;padding:7px 10px;border-radius:8px;cursor:pointer;font-size:13px;color:#374151;font-weight:500;margin-bottom:2px;}
.wltc-cat-item:hover{background:#f0f0f0;}
.wltc-cat-item.active{background:#eff6ff;color:#6366f1;font-weight:700;}
.wltc-count{background:#e5e7eb;color:#6b7280;font-size:10px;font-weight:600;padding:1px 6px;border-radius:20px;}
.wltc-cat-item.active .wltc-count{background:#dbeafe;color:#6366f1;}
.wltc-main{flex:1;overflow-y:auto;padding:16px 20px;}
.wltc-showing{font-size:12px;color:#9ca3af;margin-bottom:14px;}
.wltc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px;}
.wltc-card{border:2px solid #e5e7eb;border-radius:14px;overflow:hidden;transition:all .18s;background:#fff;cursor:pointer;}
.wltc-card:hover{border-color:#a5b4fc;box-shadow:0 6px 22px rgba(99,102,241,.14);transform:translateY(-3px);}
.wltc-card.selected{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.18);}
.wltc-preview{height:170px;overflow:hidden;position:relative;background:#f3f4f6;}
.wltc-sel-badge{position:absolute;top:8px;right:8px;background:#6366f1;color:#fff;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;display:none;}
.wltc-card.selected .wltc-sel-badge{display:block;}
.wltc-card-info{padding:11px 13px;border-top:1px solid #f3f4f6;}
.wltc-card-name{font-size:13px;font-weight:800;color:#111827;margin-bottom:3px;}
.wltc-card-desc{font-size:11px;color:#6b7280;line-height:1.5;margin-bottom:7px;}
.wltc-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:9px;}
.wltc-tag{font-size:10px;color:#6b7280;background:#f3f4f6;padding:2px 7px;border-radius:20px;font-weight:500;}
.wltc-sel-btn{width:100%;padding:8px;border:none;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;background:#111827;color:#fff;font-family:inherit;transition:background .15s;}
.wltc-sel-btn:hover{background:#000;}
.wltc-card.selected .wltc-sel-btn{background:#6366f1;}
.wltc-footer{display:flex;align-items:center;justify-content:space-between;padding:14px 28px;border-top:1px solid #e5e7eb;background:#fff;flex-shrink:0;}
.wltc-footer-left{font-size:13px;color:#6b7280;}
.wltc-footer-left strong{color:#111827;text-transform:capitalize;}
.wltc-footer-btns{display:flex;gap:10px;align-items:center;}
.wltc-back{padding:8px 18px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;background:#fff;font-family:inherit;}
.wltc-back:hover{border-color:#6b7280;}
.wltc-create{padding:9px 24px;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;background:#111827;color:#fff;font-family:inherit;}
.wltc-create:hover{background:#000;}
</style>
{% endblock %}

{% block body %}
<div class="layout">
  {% include "dashboard/_sidebar.njk" %}
  <div class="dash-main">
    <div class="topbar">
      <span class="topbar-title">🌐 Website Builder</span>
      <button class="btn btn-dark" onclick="openCreate()">+ New Website</button>
    </div>
    <div class="page">
      {% if websites.length %}
      <div class="page-header">
        <div>
          <div class="page-title">Your Websites</div>
          <div class="page-sub">{{ websites.length }} website{{ 's' if websites.length != 1 }}</div>
        </div>
      </div>
      <div class="site-grid">
        {% for w in websites %}
        <div class="site-card">
          <div class="site-thumb" style="background:linear-gradient(135deg,{{ w.settings.primary or '#6366f1' }},{{ w.settings.primary or '#8b5cf6' }}88);">
            🌐
            <span class="site-pub-badge {{ 'live' if w.is_published else 'draft' }}">
              {{ 'Live' if w.is_published else 'Draft' }}
            </span>
          </div>
          <div class="site-info">
            <div class="site-name">{{ w.title }}</div>
            <div class="site-url">pagezaper.com/w/{{ w.subdomain }}</div>
            <div class="site-actions">
              <a href="/dashboard/website/{{ w.id }}/editor" class="btn btn-dark" style="flex:1;justify-content:center;">✏️ Edit</a>
              {% if w.is_published %}
              <a href="/w/{{ w.subdomain }}" target="_blank" class="btn btn-outline">↗ View</a>
              {% endif %}
              <form method="POST" action="/dashboard/website/{{ w.id }}/delete" onsubmit="return confirm('Delete this website?')">
                <button type="submit" class="btn btn-red">🗑</button>
              </form>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class="empty">
        <div class="empty-icon">🌐</div>
        <div class="empty-title">No websites yet</div>
        <div class="empty-sub">Build a multi-page website with hero sections, galleries, contact forms and more.</div>
        <button class="btn btn-dark" onclick="openCreate()">+ Create your first website</button>
      </div>
      {% endif %}
    </div>
  </div>
</div>

<!-- Step 1: Name modal -->
<div class="modal-overlay" id="createModal" onclick="if(event.target===this)closeCreate()">
  <div class="modal">
    <div class="modal-title">Create new website</div>
    <div class="modal-sub">Give your website a name to get started.</div>
    <div class="form-group">
      <label class="form-label">Website Name</label>
      <input class="form-input" id="wlNameInput" placeholder="e.g. My Online Store" autocomplete="off">
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeCreate()">Cancel</button>
      <button type="button" class="btn btn-dark" onclick="wlNext()">Next: Pick a Theme →</button>
    </div>
  </div>
</div>

<!-- Hidden form for final submission -->
<form method="POST" action="/dashboard/website/create" id="wlForm" style="display:none;">
  <input type="hidden" name="title" id="wlTitleHidden">
  <input type="hidden" name="theme" id="wlThemeInput" value="default">
</form>

<!-- Step 2: Full-screen theme chooser -->
<div id="wlThemeChooser">
  <div class="wltc-head">
    <div class="wltc-title">Choose a theme for <span id="wlTCSiteName"></span></div>
    <div class="wltc-sub">Pick a starting point — you can change it any time in the editor.</div>
    <div class="wltc-search-row">
      <input id="wlTCSearch" class="wltc-search" placeholder="Search themes..." oninput="wlFilter()">
      <select id="wlTCCatSel" class="wltc-cat-select" onchange="wlFilter()">
        <option value="all">All categories</option>
        <option value="Modern">Modern</option>
        <option value="Classic">Classic</option>
        <option value="Dark">Dark</option>
        <option value="Clean">Clean</option>
        <option value="Bold">Bold</option>
      </select>
    </div>
  </div>
  <div class="wltc-chips">
    <button class="wltc-chip active" onclick="wlSetTag('all',this)">All</button>
    <button class="wltc-chip" onclick="wlSetTag('modern',this)">Modern</button>
    <button class="wltc-chip" onclick="wlSetTag('clean',this)">Clean</button>
    <button class="wltc-chip" onclick="wlSetTag('classic',this)">Classic</button>
    <button class="wltc-chip" onclick="wlSetTag('dark',this)">Dark</button>
    <button class="wltc-chip" onclick="wlSetTag('bold',this)">Bold</button>
    <button class="wltc-chip" onclick="wlSetTag('serif',this)">Serif</button>
    <button class="wltc-chip" onclick="wlSetTag('ecommerce',this)">Ecommerce</button>
  </div>
  <div class="wltc-body">
    <div class="wltc-sidebar">
      <div class="wltc-cat-label">CATEGORY</div>
      <div class="wltc-cat-item active" onclick="wlSetCat('all',this)">All themes <span class="wltc-count">6</span></div>
      <div class="wltc-cat-item" onclick="wlSetCat('Modern',this)">Modern <span class="wltc-count">1</span></div>
      <div class="wltc-cat-item" onclick="wlSetCat('Classic',this)">Classic <span class="wltc-count">1</span></div>
      <div class="wltc-cat-item" onclick="wlSetCat('Dark',this)">Dark <span class="wltc-count">2</span></div>
      <div class="wltc-cat-item" onclick="wlSetCat('Clean',this)">Clean <span class="wltc-count">1</span></div>
      <div class="wltc-cat-item" onclick="wlSetCat('Bold',this)">Bold <span class="wltc-count">1</span></div>
    </div>
    <div class="wltc-main">
      <div class="wltc-showing" id="wlTCShowing">Showing all 6 themes</div>
      <div class="wltc-grid" id="wlTCGrid"></div>
    </div>
  </div>
  <div class="wltc-footer">
    <div class="wltc-footer-left">Theme: <strong id="wlTCFooterLabel">Default</strong></div>
    <div class="wltc-footer-btns">
      <button class="wltc-back" onclick="wlBack()">← Back</button>
      <button class="wltc-create" onclick="wlSubmit()">Create Website →</button>
    </div>
  </div>
</div>

<script>
/* ── Theme list ── */
var WL_THEMES = [
  { id:'default',    name:'Default',      desc:'Clean modern design with soft cards and indigo accents',         tags:['modern','clean','minimal','professional'], category:'Modern'  },
  { id:'minimal',   name:'Elegant',      desc:'Warm cream palette with Playfair serif and gold accents',         tags:['elegant','serif','classic','warm'],         category:'Classic' },
  { id:'bold',      name:'Dark',         desc:'Full dark theme with glass cards and neon purple glow',           tags:['dark','bold','neon','modern'],              category:'Dark'    },
  { id:'ecom-fresh',name:'Fresh Market', desc:'Clean white with emerald green — minimal modern ecommerce',       tags:['ecommerce','clean','modern','green'],       category:'Clean'   },
  { id:'ecom-luxe', name:'Luxe',         desc:'Dark background with gold accents — premium luxury ecommerce',   tags:['ecommerce','dark','luxury','gold'],         category:'Dark'    },
  { id:'ecom-spark',name:'Spark',        desc:'Bold white with rose accents — energetic streetwear ecommerce',  tags:['ecommerce','bold','modern','colorful'],     category:'Bold'    }
];

var _wlTag = 'all', _wlCat = 'all', _wlSelected = 'default';

/* ── Open / close / navigate ── */
function openCreate() {
  document.getElementById('createModal').classList.add('open');
  setTimeout(function(){ document.getElementById('wlNameInput').focus(); }, 80);
}
function closeCreate() {
  document.getElementById('createModal').classList.remove('open');
  document.getElementById('wlThemeChooser').style.display = 'none';
  document.getElementById('wlNameInput').value = '';
  _wlSelected = 'default';
  _wlTag = 'all'; _wlCat = 'all';
}
function wlNext() {
  var name = document.getElementById('wlNameInput').value.trim();
  if (!name) { document.getElementById('wlNameInput').focus(); return; }
  document.getElementById('createModal').classList.remove('open');
  document.getElementById('wlTCSiteName').textContent = name;
  document.getElementById('wlTCFooterLabel').textContent = 'Default';
  _wlTag = 'all'; _wlCat = 'all';
  document.querySelectorAll('.wltc-chip').forEach(function(c){ c.classList.toggle('active', c.textContent.trim() === 'All'); });
  document.querySelectorAll('.wltc-cat-item').forEach(function(c,i){ c.classList.toggle('active', i===0); });
  document.getElementById('wlTCSearch').value = '';
  document.getElementById('wlTCCatSel').value = 'all';
  wlRenderGrid();
  document.getElementById('wlThemeChooser').style.display = 'flex';
}
function wlBack() {
  document.getElementById('wlThemeChooser').style.display = 'none';
  document.getElementById('createModal').classList.add('open');
  setTimeout(function(){ document.getElementById('wlNameInput').focus(); }, 80);
}
function wlSubmit() {
  document.getElementById('wlTitleHidden').value = document.getElementById('wlNameInput').value.trim();
  document.getElementById('wlThemeInput').value = _wlSelected;
  document.getElementById('wlForm').submit();
}

/* ── Pick a theme ── */
function wlPick(id) {
  _wlSelected = id;
  var t = WL_THEMES.find(function(x){ return x.id === id; });
  document.getElementById('wlTCFooterLabel').textContent = t ? t.name : id;
  document.querySelectorAll('.wltc-card').forEach(function(c){
    c.classList.toggle('selected', c.dataset.tid === id);
  });
}

/* ── Filter / search ── */
function wlSetTag(tag, el) {
  _wlTag = tag;
  document.querySelectorAll('.wltc-chip').forEach(function(c){ c.classList.remove('active'); });
  el.classList.add('active');
  wlFilter();
}
function wlSetCat(cat, el) {
  _wlCat = cat;
  document.querySelectorAll('.wltc-cat-item').forEach(function(c){ c.classList.remove('active'); });
  el.classList.add('active');
  wlFilter();
}
function wlFilter() {
  var q = (document.getElementById('wlTCSearch').value || '').toLowerCase();
  var catVal = document.getElementById('wlTCCatSel').value;
  if (catVal !== 'all') _wlCat = catVal;
  var filtered = WL_THEMES.filter(function(t) {
    var mSearch = !q || t.name.toLowerCase().includes(q) || t.desc.toLowerCase().includes(q) || t.tags.some(function(g){ return g.includes(q); });
    var mTag = _wlTag === 'all' || t.tags.includes(_wlTag);
    var mCat = _wlCat === 'all' || t.category === _wlCat;
    return mSearch && mTag && mCat;
  });
  var n = filtered.length;
  document.getElementById('wlTCShowing').textContent = 'Showing ' + (n === WL_THEMES.length ? 'all ' : '') + n + ' theme' + (n !== 1 ? 's' : '');
  wlRenderGrid(filtered);
}

/* ── Render grid ── */
function wlRenderGrid(list) {
  list = list || WL_THEMES;
  document.getElementById('wlTCGrid').innerHTML = list.map(function(t) {
    var isSel = t.id === _wlSelected;
    return '<div class="wltc-card' + (isSel ? ' selected' : '') + '" data-tid="' + t.id + '" onclick="wlPick(\'' + t.id + '\')">' +
      '<div class="wltc-preview">' +
        wlPreviewHTML(t) +
        '<div class="wltc-sel-badge">✓ Selected</div>' +
      '</div>' +
      '<div class="wltc-card-info">' +
        '<div class="wltc-card-name">' + t.name + '</div>' +
        '<div class="wltc-card-desc">' + t.desc + '</div>' +
        '<div class="wltc-tags">' + t.tags.map(function(g){ return '<span class="wltc-tag">' + g + '</span>'; }).join('') + '</div>' +
        '<button class="wltc-sel-btn" onclick="event.stopPropagation();wlPick(\'' + t.id + '\')">' + (isSel ? '✓ Selected' : 'Select') + '</button>' +
      '</div>' +
    '</div>';
  }).join('');
}

/* ── Rich preview thumbnails (matches tcPreviewHTML in website-builder.js) ── */
function wlPreviewHTML(t) {
  if (t.id === 'default') {
    return [
      '<div style="background:#fff;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;padding:0 12px;height:28px;">',
        '<div style="width:36px;height:7px;background:#6366f1;border-radius:4px;"></div>',
        '<div style="margin-left:auto;display:flex;gap:4px;">',
          '<div style="width:18px;height:5px;background:#f1f5f9;border-radius:3px;"></div>',
          '<div style="width:18px;height:5px;background:#f1f5f9;border-radius:3px;"></div>',
          '<div style="width:28px;height:5px;background:#6366f1;border-radius:3px;opacity:.25;"></div>',
        '</div>',
      '</div>',
      '<div style="background:linear-gradient(135deg,#667eea,#764ba2);padding:18px 14px;text-align:center;">',
        '<div style="width:62%;height:9px;background:rgba(255,255,255,.92);border-radius:5px;margin:0 auto 7px;"></div>',
        '<div style="width:42%;height:5px;background:rgba(255,255,255,.55);border-radius:4px;margin:0 auto 12px;"></div>',
        '<div style="display:inline-block;width:52px;height:15px;background:#fff;border-radius:30px;box-shadow:0 3px 10px rgba(0,0,0,.2);"></div>',
      '</div>',
      '<div style="background:#f8fafc;padding:10px 12px;">',
        '<div style="width:28%;height:6px;background:#0f172a;border-radius:4px;margin:0 auto 2px;"></div>',
        '<div style="width:18%;height:4px;background:#6366f1;border-radius:3px;margin:0 auto 8px;"></div>',
        '<div style="display:flex;gap:5px;">',
          '<div style="flex:1;background:#fff;border:1.5px solid #e5e7eb;border-radius:9px;padding:6px;">',
            '<div style="width:14px;height:14px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:5px;margin-bottom:4px;"></div>',
            '<div style="width:65%;height:4px;background:#111827;border-radius:2px;margin-bottom:3px;"></div>',
            '<div style="width:88%;height:3px;background:#e5e7eb;border-radius:2px;"></div>',
          '</div>',
          '<div style="flex:1;background:#fff;border:1.5px solid #e5e7eb;border-radius:9px;padding:6px;">',
            '<div style="width:14px;height:14px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:5px;margin-bottom:4px;"></div>',
